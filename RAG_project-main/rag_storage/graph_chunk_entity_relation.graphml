<node id="第11條">
  <data key="d0">第11條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 11: List of flammable solids, self-igniting substances, and substances dangerous when wet.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
