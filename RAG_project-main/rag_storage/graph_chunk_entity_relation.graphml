  <data key="d6"></data>
</node>
<node id="第1條">
  <data key="d0">第1條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 1: This regulation is established under the Occupational Safety and Health Law.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第2條">
  <data key="d0">第2條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 2: This regulation sets the minimum standards for safety and health facilities for employees.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第3條">
  <data key="d0">第3條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 3: Definitions for high voltage (above 22,800 volts), medium voltage (between 600 and 22,800 volts), and low voltage (below 600 volts).</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第4條">
  <data key="d0">第4條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 4: Definition of centrifugal machinery, including centrifugal separators, dewaterers, and casting machines.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第5條">
  <data key="d0">第5條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 5: Definition of overload prevention devices for cranes.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第6條">
  <data key="d0">第6條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 6: Definition of vehicles and construction machinery.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第7條">
  <data key="d0">第7條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 7: Definition of track-guided machinery used for transporting workers or goods.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
  <data key="d5">1789843982</data>
  <data key="d6"></data>
</node>
<node id="第8條">
  <data key="d0">第8條</data>
  <data key="d1">other</data>
  <data key="d2">Rule 8: Definition of hand trucks used for transporting goods.</data>
  <data key="d3">doc-7cf6d0aa7e2caf7c9c163d95ae18bffc-chunk-000</data>
  <data key="d4">職業安全衛生設施規則 第一章 總則.xlsx</data>
